import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="About Me"
	description="Thoughts.  Words.  Actions."
	pubDate={new Date('October 22 2026')}
	heroImage={AboutHeroImage}
>
	<p>
		I'm a husband, father, poor golfer, and have a passion for economics and politics.  I grew up 
		in Louisiana and Texas, but I've lived in Oregon for the past 26 years.  I'm 55 years old and 
		I'm deeply concerned about the sustainability of our society (economically and politically).
	</p>

	<p>
		The purpose of this blog is to share my thoughts and opinions on a few serious topics:  
		Social Security, and the national debt.  I'm aware that my opinions have little weight, 
		but I can only hope that my writings and musings here strike a chord with other people who also 
		think about these topics. 
	</p>

	
</Layout>
